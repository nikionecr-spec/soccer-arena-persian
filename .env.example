# Soccer Arena Persian — environment template
# Copy to .env on the VPS and fill real values. NEVER commit the real .env.

# --- security (REQUIRED) ---
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# --- database ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- game tuning (optional, defaults shown) ---
TURN_SECONDS=10
TARGET_GOALS=3
RECONNECT_GRACE_SECONDS=60
ELO_K=32
COIN_WIN=50
COIN_LOSS=15
COIN_GOAL=10
RATE_MSG_PER_5S=40
